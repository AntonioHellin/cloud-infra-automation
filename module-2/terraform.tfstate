            "commit_message": "Add demo GitHub Actions workflow",
            "commit_sha": "903cdd9b25fca3ef82df567c2e63e28f25f3df40",
            "content": "name: Demo Workflow\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  demo:\n    runs-on: ubuntu-latest\n    \n    steps:\n    - name: Checkout code\n      uses: actions/checkout@v4\n      \n    - name: Print repository information\n      run: |\n        echo \"🎉 This is a demo workflow created by Terraform!\"\n        echo \"📦 Repository: ${{ github.repository }}\"\n        echo \"🌿 Branch: ${{ github.ref_name }}\"\n        echo \"👤 Actor: ${{ github.actor }}\"\n        echo \"🔗 Event: ${{ github.event_name }}\"\n        \n    - name: List repository contents\n      run: |\n        echo \"📁 Repository contents:\"\n        ls -la\n        \n    - name: Show environment info\n      run: |\n        echo \"🖥️ Runner OS: ${{ runner.os }}\"\n        echo \"🏗️ Workflow: ${{ github.workflow }}\"\n        echo \"📋 Job: ${{ github.job }}\"\n        \n    - name: Terraform validation (if Terraform files exist)\n      run: |\n        if [ -f \"main.tf\" ]; then\n          echo \"🔍 Found Terraform files, validating...\"\n          # Note: In a real scenario, you'd install Terraform first\n          echo \"terraform fmt -check\"\n          echo \"terraform validate\"\n        else\n          echo \"ℹ️ No Terraform files found in this repository\"\n        fi\n        \n    - name: Success message\n      run: |\n        echo \"✅ Demo workflow completed successfully!\"\n        echo \"🚀 This repository was created and managed by Terraform\"\n        echo \"📚 Learn more about Infrastructure as Code with Terraform\"\n",
            "file": ".github/workflows/demo.yml",
