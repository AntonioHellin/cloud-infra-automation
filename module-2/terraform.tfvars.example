# Example Terraform Variables
# Copy this file to terraform.tfvars and modify the values

# Repository Configuration
repository_name = "my-awesome-terraform-repo"
description     = "An awesome repository created and managed by Terraform for learning IaC"
visibility      = "public"  # or "private"

# Repository Features
has_issues   = true
has_projects = true
has_wiki     = false

# Templates
gitignore_template = "Python"  # Python, Node, Go, Java, etc.
license_template   = "mit"     # mit, apache-2.0, gpl-3.0, etc.

# Topics/Tags
topics = [
  "terraform",
  "infrastructure-as-code",
  "automation",
  "demo",
  "learning",
  "github"
]

# Management Options
archive_on_destroy       = false   # Archive instead of delete when destroying
enable_branch_protection = true  # Enable branch protection rules
create_github_workflow   = true   # Create a sample GitHub Actions workflow

# Commit Information (for files created by Terraform)
commit_author = "Your Name"
commit_email  = "your.email@example.com"
